{
  "name": "3d-diorama-prompt",
  "version": "1.0.0",
  "private": true,
  "description": "3D cartoon diorama style prompt and documentation",
  "scripts": {
    "lint": "markdownlint \"**/*.md\" --ignore node_modules",
    "lint:fix": "markdownlint \"**/*.md\" --ignore node_modules --fix",
    "check-links": "find . -name '*.md' -not -path './node_modules/*' -print0 | xargs -0 -n1 markdown-link-check --quiet --config .markdown-link-check.json",
    "preview": "markserv -p 8080 -a 0.0.0.0 -b false ."
  },
  "devDependencies": {
    "markdown-link-check": "3.15.0",
    "markdownlint-cli": "0.49.1",
    "markserv": "1.17.4"
  }
}
